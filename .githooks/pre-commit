#!/bin/sh
# Стражи дизайн-системы до коммита, а не после.
# Ловить нарисованное «мимо системы» на проверке — поздно: правка уже сделана,
# а человек уже увидел чужую кнопку. Хук не пускает такое в репозиторий.
npm test --silent || {
  echo ""
  echo "Коммит остановлен: нарушены правила дизайн-системы (см. выше)."
  echo "Возьмите готовый компонент из @verra/design, а не рисуйте свой."
  exit 1
}
